# Copy this file to .env and fill in your own values. Never commit .env.

# Your MongoDB connection string. For Atlas it looks like:
#   mongodb+srv://<user>:<password>@<cluster>.xxxxx.mongodb.net/raju-cycles?retryWrites=true&w=majority
MONGODB_URI=

# Port the API listens on.
PORT=3001

# The frontend origin allowed to call this API from the browser (CORS).
# Local dev: the Next.js dev server. Production: your Vercel URL.
FRONTEND_ORIGIN=http://localhost:3000

# development | production | test. In production the cart + session cookies
# become SameSite=None; Secure (needed when frontend + backend are on different sites).
NODE_ENV=development

# Signs the staff session cookie. Use a long random string in production.
SESSION_SECRET=dev-insecure-session-secret-change-me

# Razorpay online payments (optional). Leave BOTH blank to run on Cash-on-Delivery
# only. Get test keys from the Razorpay dashboard (Settings > API Keys, Test mode).
# Key id is public (sent to the browser); keep the secret server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Real email via Resend (optional). Blank RESEND_API_KEY → emails print to the
# server console (dev mock). Get a key at resend.com (API Keys). MAIL_FROM must be
# an address on a domain you've verified in Resend; for quick testing you can use
# "Raju Cycles <onboarding@resend.dev>" (only delivers to your own Resend account).
RESEND_API_KEY=
MAIL_FROM=Raju Cycles <onboarding@resend.dev>

# Used ONLY by `npm run seed:staff` to create/update a login (not read at boot).
# Make the first owner, then (optionally) a manager with STAFF_ROLE=manager.
STAFF_EMAIL=
STAFF_PASSWORD=
STAFF_ROLE=owner
