# Copy to .env.local for local dev (optional — the app defaults to localhost:3001).
# The Express API's URL. Used by both server-rendering and browser fetches.
# Local dev: http://localhost:3001 . Production: your Render backend URL.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Photo / video uploads -----------------------------------------------------
# Nothing to set here. Uploads are SIGNED by the backend, which holds the Cloudinary keys
# (CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET in backend/.env). The admin shows
# its Upload buttons only when the backend says uploads are set up.
