# Copy to .env.local for local dev (optional — the app defaults to localhost:3001).
# The Express API's URL. Used by both server-rendering and browser fetches.
# Local dev: http://localhost:3001 . Production: your Render backend URL.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Cloudinary (admin image + video uploads) ---------------------------------
# Optional. Without these the admin can still paste an image URL / "/path".
# Setup: free Cloudinary account -> Settings -> Upload -> add an UNSIGNED upload
# preset (it must allow both images and videos). Add both values to .env.local
# (and to Vercel). These are public by design - no secret goes here.
# Your Cloudinary "cloud name" (shown on the dashboard).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# The name of the unsigned upload preset you created above.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# Max upload size in MB for videos (hero + product). Cloudinary free plan allows 100.
NEXT_PUBLIC_CLOUDINARY_MAX_VIDEO_MB=50
